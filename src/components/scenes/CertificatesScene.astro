---
import SceneContainer from './SceneContainer.astro';
---

<SceneContainer id="certificates">
  <div class="pixel-corners bg-[var(--color-sun)] border-4 border-[var(--color-blue-deep)] p-6 pixel-shadow max-w-2xl w-full mx-4 max-h-[80vh] overflow-hidden flex flex-col">
  <div class="flex-1 overflow-hidden p-6 flex flex-col">
    <h2 class="text-3xl text-[var(--color-blue-deep)] mb-6 text-center">Badge Case (Certificates)</h2>
    
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 overflow-y-auto justify-items-center pb-4">
      <!-- Badge Placeholder -->
      <div class="w-24 h-24 bg-[var(--color-sun)] border-4 border-[var(--color-ink)] flex flex-col items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] cursor-pointer transition-colors relative group">
        <span class="text-4xl">🎖️</span>
        <div class="absolute bottom-[-40px] hidden group-hover:block bg-white border-2 border-[var(--color-ink)] p-1 text-xs whitespace-nowrap z-10">
          TODO(owner): Cert 1
        </div>
      </div>

      <div class="w-24 h-24 bg-[var(--color-sun)] border-4 border-[var(--color-ink)] flex flex-col items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] cursor-pointer transition-colors relative group">
        <span class="text-4xl">🏅</span>
        <div class="absolute bottom-[-40px] hidden group-hover:block bg-white border-2 border-[var(--color-ink)] p-1 text-xs whitespace-nowrap z-10">
          TODO(owner): Cert 2
        </div>
      </div>
      
      <!-- Empty Slot -->
      <div class="w-24 h-24 bg-gray-200 border-4 border-dashed border-gray-400 flex items-center justify-center opacity-50">
        <span class="text-gray-400 text-sm">Empty</span>
      </div>
    </div>
  </div>
  </div>
</SceneContainer>
