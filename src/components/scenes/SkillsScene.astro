---
import SceneContainer from './SceneContainer.astro';
---

<SceneContainer id="skills">
  <div class="flex flex-col h-full justify-center items-center w-full max-w-4xl mx-auto p-8 gap-12">
    <h2 class="text-4xl text-[var(--color-blue-deep)] font-bold text-center w-full border-b-4 border-[var(--color-ink)] pb-4">SKILLS & TOOLS</h2>
    
    <div class="flex flex-wrap justify-center items-center gap-6 max-w-2xl mx-auto">
      <!-- Row 1 -->
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">React</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Astro</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Tailwind</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Laravel</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Supabase</span>
      </div>
      
      <!-- Row 2 -->
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer ml-10">
        <span class="text-xs font-bold text-center">Hardware</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Data</span>
      </div>
      <div class="w-20 h-20 rounded-full border-4 border-[var(--color-ink)] bg-white flex items-center justify-center pixel-shadow hover:bg-[var(--color-cyan)] hover:-translate-y-2 transition-transform cursor-pointer">
        <span class="text-xs font-bold text-center">Video</span>
      </div>
    </div>
  </div>
</SceneContainer>
