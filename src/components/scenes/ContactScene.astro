---
import SceneContainer from './SceneContainer.astro';
---

<SceneContainer id="contact">
  <div class="pixel-corners bg-[var(--color-sun)] border-4 border-[var(--color-blue-deep)] p-6 pixel-shadow max-w-2xl w-full mx-4 max-h-[80vh] overflow-hidden flex flex-col">
  <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
    <h2 class="text-3xl text-[var(--color-blue-deep)] mb-8">Link Cable (Contact)</h2>
    
    <div class="flex flex-col gap-4 w-full max-w-sm mx-auto">
      <a href="mailto:saragihjonathan80@gmail.com" target="_blank" rel="noopener noreferrer" class="pixel-corners bg-white border-4 border-[var(--color-ink)] p-4 pixel-shadow hover:bg-[var(--color-cyan)] transition-colors pixel-focus block">
        📧 Email Me
      </a>
      
      <a href="https://www.linkedin.com/in/jonathansaragih/" target="_blank" rel="noopener noreferrer" class="pixel-corners bg-white border-4 border-[var(--color-ink)] p-4 pixel-shadow hover:bg-[var(--color-cyan)] transition-colors pixel-focus block">
        💼 LinkedIn
      </a>
      
      <a href="https://www.instagram.com/jonathans.sa/" target="_blank" rel="noopener noreferrer" class="pixel-corners bg-white border-4 border-[var(--color-ink)] p-4 pixel-shadow hover:bg-[var(--color-cyan)] transition-colors pixel-focus block">
        📸 Instagram
      </a>
    </div>
  </div>
  </div>
</SceneContainer>
